<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sgauto.app.controller.DashboardController">

    <!-- ===================== TOPO ===================== -->
    <top>
        <HBox spacing="12" styleClass="topbar" alignment="CENTER_LEFT">
            <HBox styleClass="segmented-control" spacing="2">
                <ToggleButton fx:id="btnPeriodo7d" text="7d" styleClass="segmented-button"/>
                <ToggleButton fx:id="btnPeriodo30d" text="30d" styleClass="segmented-button"/>
                <ToggleButton fx:id="btnPeriodo90d" text="90d" styleClass="segmented-button"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAtualizar" text="Atualizar" styleClass="btn-primary"/>
        </HBox>
    </top>

    <!-- ===================== CENTRO ===================== -->
    <center>
        <VBox spacing="16" styleClass="content-area" VBox.vgrow="ALWAYS">

            <!-- LINHA 1: 7 KPIs em linha única -->
            <HBox spacing="10" VBox.vgrow="NEVER">

                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="Faturamento hoje" styleClass="card-title"/>
                        <Label text="ⓘ" styleClass="info-icon">
                            <tooltip><Tooltip text="Soma de todas as entradas no caixa hoje."/></tooltip>
                        </Label>
                    </HBox>
                    <Label fx:id="lblFaturamentoDia" text="R$ 0,00" styleClass="card-value"/>
                </VBox>

                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="Faturamento mês" styleClass="card-title"/>
                        <Label text="ⓘ" styleClass="info-icon">
                            <tooltip><Tooltip text="Soma de todas as entradas no caixa neste mês."/></tooltip>
                        </Label>
                    </HBox>
                    <Label fx:id="lblFaturamentoMes" text="R$ 0,00" styleClass="card-value"/>
                </VBox>

                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="OS finalizadas (Mês)" styleClass="card-title"/>
                        <Label text="ⓘ" styleClass="info-icon">
                            <tooltip><Tooltip text="Valor total em Ordens de Serviço finalizadas no mês."/></tooltip>
                        </Label>
                    </HBox>
                    <Label fx:id="lblFaturamentoOsMes" text="R$ 0,00" styleClass="card-value-accent"/>
                </VBox>

                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="OS Abertas" styleClass="card-title"/>
                        <Label text="ⓘ" styleClass="info-icon">
                            <tooltip><Tooltip text="Total de Ordens de Serviço em andamento."/></tooltip>
                        </Label>
                    </HBox>
                    <Label fx:id="lblOsAbertas" text="0" styleClass="card-value"/>
                    <Label fx:id="lblOsAguardando" text="0 aguardando aprovação" styleClass="card-sublabel"/>
                </VBox>

                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="Ticket médio" styleClass="card-title"/>
                        <Label text="ⓘ" styleClass="info-icon">
                            <tooltip><Tooltip text="Média do valor faturado por OS."/></tooltip>
                        </Label>
                    </HBox>
                    <Label fx:id="lblTicketMedio" text="R$ 0,00" styleClass="card-value"/>
                </VBox>

                <VBox styleClass="card, card-alerta" HBox.hgrow="ALWAYS">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="Estoque crítico" styleClass="card-title"/>
                        <Label text="ⓘ" styleClass="info-icon">
                            <tooltip><Tooltip text="Peças que atingiram o limite mínimo no estoque."/></tooltip>
                        </Label>
                    </HBox>
                    <Label fx:id="lblEstoqueCritico" text="0" styleClass="card-value-danger"/>
                </VBox>

                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="Veículos no pátio" styleClass="card-title"/>
                        <Label text="ⓘ" styleClass="info-icon">
                            <tooltip><Tooltip text="Total de veículos estacionados fisicamente na oficina."/></tooltip>
                        </Label>
                    </HBox>
                    <Label fx:id="lblVeiculosPatio" text="0" styleClass="card-value"/>
                </VBox>
            </HBox>

            <!-- LINHA 2: Gráficos Principais -->
            <HBox spacing="12" VBox.vgrow="ALWAYS">
                <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefWidth="450">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="Ordens de Serviço por status" styleClass="section-title"/>
                        <Label text="ⓘ" styleClass="info-icon">
                            <tooltip><Tooltip text="Distribuição do funil de atendimento em tempo real."/></tooltip>
                        </Label>
                    </HBox>
                    <BarChart fx:id="chartOsPorStatus" styleClass="dashboard-chart" legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis/></xAxis>
                        <yAxis><NumberAxis/></yAxis>
                    </BarChart>
                </VBox>

                <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefWidth="450">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="Faturamento no período" styleClass="section-title"/>
                        <Label text="ⓘ" styleClass="info-icon">
                            <tooltip><Tooltip text="Evolução histórica das movimentações de entrada financeiras."/></tooltip>
                        </Label>
                    </HBox>
                    <LineChart fx:id="chartFaturamento" styleClass="dashboard-chart" legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis/></xAxis>
                        <yAxis><NumberAxis/></yAxis>
                    </LineChart>
                </VBox>
            </HBox>

            <!-- LINHA 3: Gráficos Secundários + Tabela -->
            <HBox spacing="12" VBox.vgrow="ALWAYS">
                <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefWidth="300">
                    <Label text="Forma de pagamento" styleClass="section-title"/>
                    <PieChart fx:id="chartFormaPagamento" styleClass="dashboard-chart" VBox.vgrow="ALWAYS"/>
                </VBox>

                <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefWidth="300">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="Serviços mais realizados" styleClass="section-title"/>
                        <Label text="ⓘ" styleClass="info-icon">
                            <tooltip><Tooltip text="Top 5 serviços executados no período selecionado."/></tooltip>
                        </Label>
                    </HBox>
                    <BarChart fx:id="chartServicosMaisRealizados" styleClass="dashboard-chart" legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis/></xAxis>
                        <yAxis><NumberAxis/></yAxis>
                    </BarChart>
                </VBox>

                <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefWidth="300">
                    <Label text="Estoque crítico (Resumo)" styleClass="section-title"/>
                    <TableView fx:id="tabelaPecasCriticas" styleClass="modern-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPecaNome" text="Peça" prefWidth="130"/>
                            <TableColumn fx:id="colPecaQuantidade" text="Qtd." prefWidth="50"/>
                            <TableColumn fx:id="colPecaMinimo" text="Mín." prefWidth="50"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                </VBox>
            </HBox>

        </VBox>
    </center>
</BorderPane>