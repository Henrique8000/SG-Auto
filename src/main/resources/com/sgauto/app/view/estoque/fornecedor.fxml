<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sgauto.app.controller.estoque.fornecedor.FornecedorController">

    <!-- Definição do Grupo de Botões (Filtro de Status) -->
    <fx:define>
        <ToggleGroup fx:id="grupoStatus"/>
    </fx:define>

    <!-- CABEÇALHO: Cards, Busca e Filtros -->
    <top>
        <VBox spacing="16">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- 1. Cards de Indicadores (KPIs) -->
            <HBox spacing="16">
                <VBox styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="TOTAL CADASTRADOS" styleClass="card-title"/>
                    <Label fx:id="lblTotalFornecedores" text="0" styleClass="card-value"/>
                </VBox>

                <VBox styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="FORNECEDORES ATIVOS" styleClass="card-title"/>
                    <Label fx:id="lblFornecedoresAtivos" text="0" styleClass="card-value-accent"/>
                </VBox>

                <VBox styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="FORNECEDORES INATIVOS" styleClass="card-title"/>
                    <Label fx:id="lblFornecedoresInativos" text="0" styleClass="card-value-warning"/>
                </VBox>
            </HBox>

            <!-- 2. Barra de Pesquisa Principal e Botão Novo -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="txtBusca" promptText="Buscar por razão social, fantasia ou CNPJ/CPF..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnNovoFornecedor" text="+ Novo Fornecedor" styleClass="btn-primary" onAction="#abrirModalNovo"/>
            </HBox>

            <!-- 3. Filtros Secundários (Status e Categoria) -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <HBox styleClass="segmented-control">
                    <ToggleButton fx:id="btnStatusTodos" text="Todos" styleClass="segmented-button" toggleGroup="$grupoStatus" selected="true"/>
                    <ToggleButton fx:id="btnStatusAtivos" text="Ativos" styleClass="segmented-button" toggleGroup="$grupoStatus"/>
                    <ToggleButton fx:id="btnStatusInativos" text="Inativos" styleClass="segmented-button" toggleGroup="$grupoStatus"/>
                </HBox>

                <ComboBox fx:id="cmbCategoria" promptText="Todas as categorias" styleClass="search-field" prefWidth="220"/>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTRO: Tabela e Tela Vazia -->
    <center>
        <StackPane>
            <padding>
                <Insets right="20" bottom="0" left="20"/>
            </padding>

            <TableView fx:id="tabelaFornecedores" styleClass="modern-table">
                <columns>
                    <TableColumn fx:id="colRazao" text="Razão Social" prefWidth="220"/>
                    <TableColumn fx:id="colDocumento" text="CNPJ/CPF" prefWidth="130"/>
                    <TableColumn fx:id="colContato" text="Contato (Rep.)" prefWidth="130"/>
                    <TableColumn fx:id="colTelefone" text="Telefone/Celular" prefWidth="120"/>
                    <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="130"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
                    <TableColumn fx:id="colAcoes" text="Ações" prefWidth="160"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
            </TableView>

            <!-- Painel exibido quando não houver resultados -->
            <VBox fx:id="painelVazio" alignment="CENTER" spacing="8" visible="false" managed="false">
                <Label text="🔍" styleClass="empty-state-icon"/>
                <Label text="Nenhum fornecedor encontrado" styleClass="empty-state-title"/>
                <Label text="Tente ajustar os filtros ou cadastre um novo fornecedor" styleClass="empty-state-subtitle"/>
            </VBox>
        </StackPane>
    </center>

    <!-- RODAPÉ: Paginação -->
    <bottom>
        <VBox>
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <fx:include source="../paginacao-controle.fxml" fx:id="paginacao"/>
        </VBox>
    </bottom>

</BorderPane>