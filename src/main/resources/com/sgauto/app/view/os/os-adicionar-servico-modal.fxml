<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgauto.app.controller.os.OsAdicionarServicoModalController"
      styleClass="modal-container" spacing="16" prefWidth="420">

    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="Adicionar Serviço" styleClass="page-title"/>

    <VBox spacing="4">
        <Label text="Serviço" styleClass="form-label"/>
        <ComboBox fx:id="cmbServico" styleClass="form-input" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Quantidade" styleClass="form-label"/>
        <TextField fx:id="txtQuantidade" styleClass="form-input" text="1"/>
    </VBox>

    <Label fx:id="lblErro" styleClass="form-error" managed="false" visible="false" wrapText="true"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancelar" styleClass="btn-secondary" onAction="#cancelar"/>
        <Button fx:id="btnConfirmar" text="Adicionar" styleClass="btn-primary" onAction="#confirmar"/>
    </HBox>
</VBox>