<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgauto.app.controller.patio.EntradaPatioModalController"
      styleClass="modal-container" spacing="14" prefWidth="480">

    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="Nova Entrada no Pátio" styleClass="page-title"/>

    <VBox spacing="4">
        <Label text="Cliente" styleClass="form-label"/>
        <ComboBox fx:id="cmbCliente" styleClass="form-input" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Veículo" styleClass="form-label"/>
        <ComboBox fx:id="cmbVeiculo" styleClass="form-input" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Ordem de Serviço (opcional)" styleClass="form-label"/>
        <ComboBox fx:id="cmbOrdemServico" styleClass="form-input" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Tarifa" styleClass="form-label"/>
        <ComboBox fx:id="cmbTarifa" styleClass="form-input" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Motivo" styleClass="form-label"/>
        <ComboBox fx:id="cmbMotivo" styleClass="form-input" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Localização no Pátio" styleClass="form-label"/>
        <TextField fx:id="txtLocalizacao" styleClass="form-input" promptText="Ex: Vaga A3"/>
    </VBox>

    <Label fx:id="lblErro" styleClass="form-error" managed="false" visible="false" wrapText="true"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancelar" styleClass="btn-secondary" onAction="#cancelar"/>
        <Button fx:id="btnSalvar" text="Registrar Entrada" styleClass="btn-primary" onAction="#salvar"/>
    </HBox>
</VBox>