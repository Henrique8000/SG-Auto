<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sgauto.app.controller.patio.PatioHistoricoTabController">

    <fx:define>
        <ToggleGroup fx:id="grupoStatus"/>
    </fx:define>

    <top>
        <VBox spacing="16">
            <padding><Insets bottom="20"/></padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="txtBusca" promptText="Buscar por placa ou cliente..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <HBox styleClass="segmented-control">
                    <ToggleButton fx:id="btnStatusTodos" text="Todos" styleClass="segmented-button" toggleGroup="$grupoStatus" selected="true"/>
                    <ToggleButton fx:id="btnStatusNoPatio" text="No Pátio" styleClass="segmented-button" toggleGroup="$grupoStatus"/>
                    <ToggleButton fx:id="btnStatusFinalizado" text="Finalizado" styleClass="segmented-button" toggleGroup="$grupoStatus"/>
                </HBox>

                <Label text="De:" styleClass="form-label"/>
                <DatePicker fx:id="dpDataInicio" styleClass="form-input"/>
                <Label text="Até:" styleClass="form-label"/>
                <DatePicker fx:id="dpDataFim" styleClass="form-input"/>
                <Button text="Limpar Filtros" styleClass="btn-secondary" onAction="#limparFiltros"/>

                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblContagem" styleClass="results-count"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane>
            <TableView fx:id="tabelaHistorico" styleClass="modern-table">
                <columns>
                    <TableColumn fx:id="colPlaca" text="Placa" prefWidth="90"/>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="160"/>
                    <TableColumn fx:id="colOs" text="O.S." prefWidth="60"/>
                    <TableColumn fx:id="colMotivo" text="Motivo" prefWidth="130"/>
                    <TableColumn fx:id="colEntrada" text="Entrada" prefWidth="130"/>
                    <TableColumn fx:id="colSaida" text="Saída" prefWidth="130"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
                    <TableColumn fx:id="colValor" text="Valor" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
            </TableView>

            <VBox fx:id="painelVazio" alignment="CENTER" spacing="8" visible="false" managed="false">
                <Label text="🔍" styleClass="empty-state-icon"/>
                <Label text="Nenhuma movimentação encontrada" styleClass="empty-state-title"/>
                <Label text="Tente ajustar os filtros de período ou status" styleClass="empty-state-subtitle"/>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER" BorderPane.alignment="CENTER">
            <padding><Insets top="16"/></padding>
            <Button fx:id="btnPaginaAnterior" text="◀ Anterior" styleClass="btn-secondary" onAction="#irPaginaAnterior"/>
            <Label fx:id="lblPaginaAtual" styleClass="results-count" text="Página 1 de 1"/>
            <Button fx:id="btnProximaPagina" text="Próxima ▶" styleClass="btn-secondary" onAction="#irProximaPagina"/>
        </HBox>
    </bottom>
</BorderPane>