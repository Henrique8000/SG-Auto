<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sgauto.app.controller.funcionario.FuncionarioController">

    <fx:define>
        <ToggleGroup fx:id="grupoRemovido"/>
    </fx:define>

    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <top>
        <VBox spacing="16">
            <padding><Insets bottom="20"/></padding>

            <HBox spacing="16">
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="TOTAL DE FUNCIONÁRIOS" styleClass="card-title"/>
                    <Label fx:id="lblTotal" text="0" styleClass="card-value"/>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="ATIVOS" styleClass="card-title"/>
                    <Label fx:id="lblAtivos" text="0" styleClass="card-value-accent"/>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="APTOS PARA O.S." styleClass="card-title"/>
                    <Label fx:id="lblAptosOs" text="0" styleClass="card-value"/>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="CNH VENCIDA/VENCENDO (30d)" styleClass="card-title"/>
                    <Label fx:id="lblCnhAlerta" text="0" styleClass="card-value-warning"/>
                </VBox>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="txtBusca" promptText="Buscar por nome, matrícula, CPF, celular ou e-mail..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <Button text="+ Novo Funcionário" styleClass="btn-primary" onAction="#abrirModalNovoFuncionario"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <HBox styleClass="segmented-control">
                    <ToggleButton fx:id="btnAtivos" text="Ativos no sistema" styleClass="segmented-button" toggleGroup="$grupoRemovido" selected="true"/>
                    <ToggleButton fx:id="btnRemovidos" text="Removidos" styleClass="segmented-button" toggleGroup="$grupoRemovido"/>
                </HBox>

                <ComboBox fx:id="cmbFiltroStatus" promptText="Todos os status" styleClass="search-field"/>
                <ComboBox fx:id="cmbFiltroCargo" promptText="Todos os cargos" styleClass="search-field"/>
                <ComboBox fx:id="cmbFiltroContrato" promptText="Todos os contratos" styleClass="search-field"/>
                <ComboBox fx:id="cmbOrdenar" promptText="Ordenar por" styleClass="search-field"/>

                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Opções Avançadas" styleClass="btn-primary" onAction="#abrirModalAvancadas"/>
            </HBox>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <CheckBox fx:id="chkSomenteAptosOs" text="Somente disponíveis para O.S."/>
                <CheckBox fx:id="chkSomenteCnhVencida" text="Somente CNH vencida"/>

                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblContagem" styleClass="results-count"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane>
            <TableView fx:id="tabelaFuncionarios" styleClass="modern-table">
                <columns>
                    <TableColumn fx:id="colMatricula" text="Matrícula" prefWidth="80"/>
                    <TableColumn fx:id="colNome" text="Nome" prefWidth="190"/>
                    <TableColumn fx:id="colCargo" text="Cargo" prefWidth="130"/>
                    <TableColumn fx:id="colContrato" text="Contrato" prefWidth="100"/>
                    <TableColumn fx:id="colCelular" text="Celular" prefWidth="110"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="colApto" text="O.S." prefWidth="70"/>
                    <TableColumn fx:id="colAcoes" text="Ações" prefWidth="230"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
            </TableView>

            <VBox fx:id="painelVazio" alignment="CENTER" spacing="8" visible="false" managed="false">
                <Label text="🔍" styleClass="empty-state-icon"/>
                <Label text="Nenhum funcionário encontrado" styleClass="empty-state-title"/>
                <Label text="Tente ajustar os filtros ou cadastre um novo funcionário" styleClass="empty-state-subtitle"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>