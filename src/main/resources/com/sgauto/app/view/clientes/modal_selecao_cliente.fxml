<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="modal-container" prefWidth="600" prefHeight="450"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgauto.app.controller.clientes.ModalSelecaoClienteController">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Selecionar Cliente" styleClass="page-title" />
    <Separator styleClass="border-subtle" />

    <!-- Barra de Pesquisa -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Pesquisar:" styleClass="form-label"/>
        <TextField fx:id="txtBusca" promptText="Nome, CPF/CNPJ ou Telefone..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Tabela de Clientes -->
    <TableView fx:id="tbClientes" styleClass="modern-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNome" text="Nome / Razão Social" prefWidth="250">
                <cellValueFactory><PropertyValueFactory property="nome"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colDocumento" text="Documento" prefWidth="130">
                <cellValueFactory><PropertyValueFactory property="documento"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colTelefone" text="Telefone/Telemóvel" prefWidth="130">
                <cellValueFactory><PropertyValueFactory property="telefone"/></cellValueFactory>
            </TableColumn>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Separator styleClass="border-subtle" />

    <!-- Botões -->
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#cancelar" styleClass="btn-secondary" />
        <Button text="Confirmar Seleção" onAction="#selecionar" styleClass="btn-primary" />
    </HBox>
</VBox>