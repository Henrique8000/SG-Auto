<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sgauto.app.controller.financeiro.ContaReceberListagemController"
            styleClass="content-area"
            prefWidth="900" prefHeight="560">

    <top>
        <VBox spacing="14">
            <padding><Insets top="0" right="0" bottom="16" left="0"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Contas a Receber" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnNovaConta" text="Nova conta" styleClass="btn-primary"/>
                <Button fx:id="btnDarBaixa" text="Dar baixa" styleClass="btn-secondary"/>
                <Button fx:id="btnCancelar" text="Cancelar" styleClass="btn-secondary"/>
            </HBox>

            <HBox spacing="12" alignment="BOTTOM_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Cliente" styleClass="form-label"/>
                    <TextField fx:id="txtCliente" promptText="Buscar por nome do cliente" styleClass="search-field"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Status" styleClass="form-label"/>
                    <ComboBox fx:id="filtroStatus" promptText="Todos os status" prefWidth="170" styleClass="search-field"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Vencimento de" styleClass="form-label"/>
                    <DatePicker fx:id="dpVencimentoDe" prefWidth="150" styleClass="form-input"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Vencimento até" styleClass="form-label"/>
                    <DatePicker fx:id="dpVencimentoAte" prefWidth="150" styleClass="form-input"/>
                </VBox>
                <Button fx:id="btnLimpar" text="Limpar filtros" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabela" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="240"/>
                <TableColumn fx:id="colCliente" text="Cliente" prefWidth="180"/>
                <TableColumn fx:id="colParcela" text="Parcela" prefWidth="80"/>
                <TableColumn fx:id="colValor" text="Valor" prefWidth="110"/>
                <TableColumn fx:id="colVencimento" text="Vencimento" prefWidth="110"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox>
            <Label fx:id="lblMensagem" styleClass="form-error">
                <padding><Insets top="8" right="0" bottom="0" left="0"/></padding>
            </Label>
            <!-- AJUSTE o caminho para onde está o seu FXML de paginação -->
            <fx:include fx:id="paginacao" source="/com/sgauto/app/view/paginacao-controle.fxml"/>
        </VBox>
    </bottom>

</BorderPane>