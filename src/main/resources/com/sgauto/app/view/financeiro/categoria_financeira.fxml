<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sgauto.app.controller.financeiro.CategoriaFinanceiraController"
            stylesheets="@../../css/estilo.css">

    <!-- Espaçamento geral da tela -->
    <padding>
        <Insets top="0" right="0" bottom="20" left="0"/>
    </padding>

    <!-- TOPO: Título (Usando tipografia do Design System) -->
    <top>
        <VBox spacing="4" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="24"/>
            </padding>
            <Label text="Categorias Financeiras" styleClass="page-title"/>
            <Label text="Gerencie as categorias de despesas e receitas da oficina." styleClass="page-subtitle"/>
        </VBox>
    </top>

    <!-- CENTRO: Tabela de Categorias -->
    <center>
        <VBox spacing="16" BorderPane.alignment="CENTER">
            <padding>
                <Insets right="24"/>
            </padding>

            <!-- NOVO: Barra de Ferramentas / Filtros -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscaNome" promptText="Buscar por nome..." styleClass="search-field" prefWidth="250" onKeyReleased="#aoDigitarBusca"/>
                <ComboBox fx:id="cbFiltroTipo" promptText="Todos os Tipos" styleClass="search-field" prefWidth="180" onAction="#aplicarFiltros"/>

                <CheckBox fx:id="chkMostrarInativas" text="Mostrar Inativas" styleClass="check-box" onAction="#aplicarFiltros"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Limpar Filtros" styleClass="btn-secondary" onAction="#limparFiltros"/>
            </HBox>

            <TableView fx:id="tabelaCategorias" VBox.vgrow="ALWAYS" styleClass="modern-table">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60" maxWidth="80"/>
                    <TableColumn fx:id="colNome" text="Nome da Categoria" prefWidth="250"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Paginação -->
            <fx:include fx:id="paginacao" source="../paginacao-controle.fxml"/>
        </VBox>
    </center>

    <!-- DIREITA: Formulário de Cadastro/Edição (Substituído fundo claro pela estrutura de Card do Dark Theme) -->
    <right>
        <!-- Utilizando 'chart-card' pois ele herda fundo, borda e cantos arredondados sem travar a altura em 96px como o '.card' comum -->
        <VBox spacing="16" prefWidth="320" styleClass="chart-card" BorderPane.alignment="CENTER">

            <Label text="Dados da Categoria" styleClass="section-title"/>

            <VBox spacing="6">
                <Label text="Nome da Categoria" styleClass="form-label"/>
                <TextField fx:id="txtNome" styleClass="form-input" promptText="Ex: Conta de Luz"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Tipo de Movimentação" styleClass="form-label"/>
                <ComboBox fx:id="cbTipo" styleClass="form-input" maxWidth="Infinity" promptText="Selecione..."/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Botões padronizados -->
            <VBox spacing="12">
                <Button fx:id="btnSalvar" text="Salvar Categoria" maxWidth="Infinity" styleClass="btn-primary" onAction="#salvarCategoria"/>
                <Button fx:id="btnNovo" text="Limpar / Novo" maxWidth="Infinity" styleClass="btn-secondary" onAction="#limparFormulario"/>

                <!-- Botão de exclusão utilizando a variável '-danger' do CSS -->
                <Button fx:id="btnAlternarStatus" text="Desativar Selecionada" maxWidth="Infinity" disable="true" onAction="#alternarStatusCategoria"
                        style="-fx-background-color: transparent; -fx-border-color: -danger; -fx-text-fill: -danger; -fx-border-radius: 4; -fx-padding: 9 18; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </right>

</BorderPane>