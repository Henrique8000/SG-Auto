<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sgauto.app.controller.usuario.UsuarioController">

    <fx:define>
        <ToggleGroup fx:id="grupoStatus"/>
    </fx:define>

    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <top>
        <VBox spacing="16">
            <padding><Insets bottom="16"/></padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="txtBusca" promptText="Buscar por login, nome ou e-mail..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <Button text="+ Novo Usuário" styleClass="btn-primary" onAction="#abrirModalNovoUsuario"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <HBox styleClass="segmented-control">
                    <ToggleButton fx:id="btnStatusTodos" text="Todos" styleClass="segmented-button" toggleGroup="$grupoStatus" selected="true"/>
                    <ToggleButton fx:id="btnStatusAtivos" text="Ativos" styleClass="segmented-button" toggleGroup="$grupoStatus"/>
                    <ToggleButton fx:id="btnStatusInativos" text="Inativos" styleClass="segmented-button" toggleGroup="$grupoStatus"/>
                </HBox>
                <ComboBox fx:id="cmbFiltroPerfil" promptText="Todos os perfis" styleClass="search-field"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabelaUsuarios" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colLogin" text="Login" prefWidth="120"/>
                <TableColumn fx:id="colNome" text="Nome" prefWidth="200"/>
                <TableColumn fx:id="colPerfil" text="Perfil" prefWidth="140"/>
                <TableColumn fx:id="colUltimoLogin" text="Último Login" prefWidth="150"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                <TableColumn fx:id="colAcoes" text="Ações" prefWidth="230"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <fx:include fx:id="paginacao" source="../paginacao-controle.fxml"/>
    </bottom>
</BorderPane>