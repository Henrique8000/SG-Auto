<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sgauto.app.controller.usuario.PerfilAcessoController">

    <fx:define>
        <ToggleGroup fx:id="grupoStatus"/>
    </fx:define>

    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <top>
        <VBox spacing="16">
            <padding><Insets bottom="16"/></padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="txtBusca" promptText="Buscar por nome ou descrição..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <Button text="+ Novo Perfil" styleClass="btn-primary" onAction="#abrirModalNovoPerfil"/>
            </HBox>
            <HBox styleClass="segmented-control">
                <ToggleButton fx:id="btnStatusTodos" text="Todos" styleClass="segmented-button" toggleGroup="$grupoStatus" selected="true"/>
                <ToggleButton fx:id="btnStatusAtivos" text="Ativos" styleClass="segmented-button" toggleGroup="$grupoStatus"/>
                <ToggleButton fx:id="btnStatusInativos" text="Inativos" styleClass="segmented-button" toggleGroup="$grupoStatus"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabelaPerfis" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colNome" text="Nome" prefWidth="180"/>
                <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="260"/>
                <TableColumn fx:id="colQtdPermissoes" text="Permissões" prefWidth="100"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                <TableColumn fx:id="colAcoes" text="Ações" prefWidth="200"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <fx:include fx:id="paginacao" source="../paginacao-controle.fxml"/>
    </bottom>
</BorderPane>